{
	"name": "terrariavania",
	"version": "0.0.0",
	"private": true,
	"workspaces": {
		"catalog": {
			"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
			"vitest": "4.1.11",
			"vite-plus": "0.3.1",
			"@vitest/coverage-v8": "4.1.11"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "tsc && vp build",
		"preview": "vp preview",
		"prepare": "vp config",
		"test": "vp test run",
		"test:coverage": "vp test run --coverage",
		"test:watch": "vp test watch",
		"e2e": "bddgen && playwright test",
		"e2e:generate": "bddgen",
		"audit": "fallow audit",
		"perf": "node performance/cli.ts perf",
		"perf:diagnose": "node performance/cli.ts perf:diagnose",
		"perf:query": "QUERY_VARIANT=named RUN_QUERY_BENCHMARK=1 vp test run src/benchmark/query-benchmark.test.ts --reporter=verbose",
		"perf:full": "node performance/cli.ts perf:full",
		"perf:baseline": "node performance/cli.ts perf:baseline",
		"typecheck:performance": "vp exec tsc -p tsconfig.performance.json"
	},
	"dependencies": {
		"koota": "^0.6.6",
		"pixi.js": "^8.20.1"
	},
	"devDependencies": {
		"@jridgewell/trace-mapping": "^0.3.31",
		"@playwright/test": "^1.63.0",
		"@types/node": "^24.13.4",
		"@vitest/coverage-v8": "catalog:",
		"fallow": "^3.25.0",
		"playwright": "^1.63.0",
		"playwright-bdd": "9.2.1",
		"typescript": "~6.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"overrides": {
		"vite@*": "catalog:",
		"vitest@*": "catalog:"
	},
	"packageManager": "pnpm@12.4.1"
}
